{
  "name": "bellart",
  "version": "1.0.0",
  "description": "Bella Art in Madeira — Sistema ERP",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.bellaart.erp",
    "productName": "Bellart",
    "copyright": "Bella Art in Madeira",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "app/**/*",
      "data/.gitkeep",
      "python-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python-dist/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "bellart.ini"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/static/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bellart ERP",
      "installerIcon": "frontend/static/logo.ico",
      "uninstallerIcon": "frontend/static/logo.ico",
      "installerHeaderIcon": "frontend/static/logo.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
